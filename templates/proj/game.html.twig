{# templates/home.html.twig #}

{% extends "proj.html.twig" %}

{% block title %}MVC Kmom10{% endblock %}

{% block body %}

    <div class="game play fill">
    <img src= "{{ asset('build/images/'~gameState.getCurrentImage()~'.jpg') }}" alt="view of the room" width=700 >

    <p>{{ gameState.getCurrentRoom().getDescription()}}</p>

    {{ include('flash.html.twig') }}

 
    <hr>    

    <div class="actions-pockets">
    <div class="actions">
        <div class ="item">
            <form method="post" action="{{ path('game_move') }}">    
                {% for exit in gameState.getExits() |keys %}
                <button class= "submit" name="exit" type="submit" value = {{ exit }}>
                    Gå {{ exit }}      
                </button>
                {% endfor %}
            </form>
        </div>


        {% for item in gameState.getCurrentRoom.getItems() %}
            {% if not item.isHidden() %}
                <div class="item">
                    <form method="post" action="{{ path('game_examine') }}">
                        <button class= "submit" name="examine" type="submit" value = {{ item.getId }}>
                            Undersök {{ item.getId }}      
                        </button>
                    </form>

                    <form method="post" action="{{ path('game_pickup') }}">
                        <button class= "submit" name="pick" type="submit" value = {{ item.getId }}>
                            Plocka upp {{ item.getId }}      
                        </button>
                    </form>

                    {% if gameState.getInventory() %}
                        <form method="post" action="{{ path('game_combine') }}">
                                <button class= "submit" name="item" type="submit" value = {{ item.getId }}>
                                    Kombinera {{ item.getId }} med       
                                </button>
                                <select name ="combo">
                                    {% for thing in gameState.getInventory() %}
                                        <option value ="{{ thing.getId }}">{{ thing.getId }}</option>
                                    {% endfor %}
                                </select>
                            </form>
                        {% endif %}
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        
        <div class="pockets">
        <p>I dina fickor:<br>

        {% if not gameState.getInventory()%}
        <br>Bara lite ludd...
        {% endif %}
        </p>

            <form method="post" action="{{ path('game_examine_pocket') }}">
                {% for item in gameState.getInventory() %}
                    <p>{{ item.getId() }}</p>
                    <button class= "submit" name="item" type="submit" value = {{ item.getId() }}>
                        Undersök
                        </button>
                    <button class= "submit" name="item" type="submit" value = {{ item.getId() }} onClick="this.form.action='{{ path('game_drop') }}'">
                        Lägg ifrån dig
                    </button>
                        {% endfor %}
            </form>
        </div>
    </div>
    </div>                
        
{% endblock %}

